pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['DEV', 'TEST', 'PROD'],
            description: 'Select the environment for deployment'
        )
    }

    stages {
        stage('Set Environment') {
            steps {
                script {
                    if (params.ENVIRONMENT == 'DEV') {
                        env.CONTAINER_NAME = 'jenkins-nginx-dev'
                        env.PORT = '5004'
                    } else if (params.ENVIRONMENT == 'TEST') {
                        env.CONTAINER_NAME = 'jenkins-nginx-test'
                        env.PORT = '5001'
                    } else if (params.ENVIRONMENT == 'PROD') {
                        env.CONTAINER_NAME = 'jenkins-nginx-prod'
                        env.PORT = '5002'
                    }
                }
            }
        }

        stage('Show Selected Environment') {
            steps {
                echo "Deploying to ${params.ENVIRONMENT}"
                echo "Container: ${env.CONTAINER_NAME}"
                echo "Port: ${env.PORT}"
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t jenkins-nginx-website .'
            }
        }

        stage('Stop Old Container') {
            steps {
                sh 'docker rm -f ${CONTAINER_NAME} || true'
            }
        }

        stage('Run New Container') {
            steps {
                sh 'docker run -d --name ${CONTAINER_NAME} -p ${PORT}:80 jenkins-nginx-website'
            }
        }

        stage('Deployment Complete') {
            steps {
                echo "Website deployed successfully to ${params.ENVIRONMENT}!"
            }
        }
    }
}
