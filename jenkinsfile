pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['DEV', 'TEST', 'PROD'],
            description: 'Select the environment for deployment'
        )
    }

    stages {
        stage('Show Selected Environment') {
            steps {
                echo "Deploying to ${params.ENVIRONMENT} environment"
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t jenkins-nginx-website .'
            }
        }

        stage('Stop Old Container') {
            steps {
                sh 'docker rm -f jenkins-nginx-container || true'
            }
        }

        stage('Run New Container') {
            steps {
                sh 'docker run -d --name jenkins-nginx-container -p 5000:80 jenkins-nginx-website'
            }
        }

        stage('Deployment Complete') {
            steps {
                echo "Website deployed successfully to ${params.ENVIRONMENT}!"
            }
        }
    }
}
